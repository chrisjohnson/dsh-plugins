{
  "name": "dsh-kanban",
  "version": "0.1.5",
  "description": "Ticket-centric work organizer and workflow engine for DeepSeek Harness: a local SQLite board whose phases are driven by code, spawning sandboxed role sessions, gating on per-provider capacity, and recording a complete time/token ledger.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "prompts",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "DECISIONS.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "kanban",
    "workflow",
    "orchestration",
    "sqlite"
  ],
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjohnson/dsh-plugins.git",
    "directory": "packages/kanban"
  },
  "homepage": "https://github.com/chrisjohnson/dsh-plugins/tree/main/packages/kanban#readme",
  "bugs": "https://github.com/chrisjohnson/dsh-plugins/issues",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
