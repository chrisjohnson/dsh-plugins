{
  "name": "dsh-model-capacity",
  "version": "0.6.0",
  "description": "Process-wide, per-provider model-call capacity for DeepSeek Harness: every model call, an interactive turn or a subagent child's, queues FIFO for its provider, and the host exposes an activity and queue inspection panel.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "capacity",
    "semaphore",
    "concurrency",
    "queue"
  ],
  "engines": {
    "node": ">=22.5.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjohnson/dsh-plugins.git",
    "directory": "packages/model-capacity"
  },
  "homepage": "https://github.com/chrisjohnson/dsh-plugins/tree/main/packages/model-capacity#readme",
  "bugs": {
    "url": "https://github.com/chrisjohnson/dsh-plugins/issues"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
