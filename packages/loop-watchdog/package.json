{
  "name": "dsh-loop-watchdog",
  "version": "0.1.0",
  "description": "A stuck-session watchdog for DeepSeek Harness: a deterministic repetition check plus optional model adjudication writes a per-step evaluation ledger, can steer a looping session, and ships an evals panel for dsh-better-sidebar.",
  "type": "module",
  "license": "MIT",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "watchdog",
    "loop-detection",
    "agent-supervision",
    "better-sidebar"
  ],
  "engines": {
    "node": ">=20.9.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0-0 || >=0.3.0-0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrisjohnson/dsh-plugins.git",
    "directory": "packages/loop-watchdog"
  },
  "homepage": "https://github.com/chrisjohnson/dsh-plugins/tree/main/packages/loop-watchdog#readme",
  "bugs": "https://github.com/chrisjohnson/dsh-plugins/issues",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
